# ==============================================================================
# CAMPUS VOICE — ENVIRONMENT VARIABLES SPECIFICATION (MILESTONE 1)
# Zero-Cost Infrastructure | Multi-Tenant Architecture
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Cloud PostgreSQL)
# - DATABASE_URL: Transaction connection pooler (port 6543 on Supabase) for serverless execution.
# - DIRECT_URL: Direct session connection (port 5432 on Supabase) for Prisma migrations and schema pushes.
# Zero-Cost Note: Free tier on Supabase provides 500 MB database and up to 60 direct / 200 pooler connections.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Authentication & Session Security
# - SESSION_SECRET: Minimum 32-character high-entropy secret used for HMAC/session validation.
SESSION_SECRET="change-this-to-a-very-secure-random-32-byte-hex-string-in-production"

# Runtime Environment
NODE_ENV="development"

# Canonical Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Supabase Storage & Public Keys (Prepared for M2 without enabling paid tiers)
# SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# SUPABASE_ANON_KEY="eyJhbGciOi..."
